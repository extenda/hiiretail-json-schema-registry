              "properties": {
                "category": {
                  "title": "Category",
                  "const": "screen"
                },
                "screenAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "findItem",
                      "title": "Find an item"
                    },
                    {
                      "const": "pluMenu",
                      "title": "PLU menu"
                    },
                    {
                      "const": "variantSearch",
                      "title": "Browse categories"
                    },
                    {
                      "const": "externalLinks",
                      "title": "Web links"
                    }
                  ]
                }
              }
            },
            {
              "title": "Advanced: engine command",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "command"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "command"
                },
                "command": {
                  "title": "Engine command",
                  "description": "The exact Checkout Engine command name, for example SuspendOrderCommand. Ask Extenda before using it.",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.]{1,80}$"
                }
              }
            }
          ]
        },
        "icon": {
          "$ref": "#/$defs/Icon"
        },
        "imageUrl": {
          "title": "Picture",
          "description": "Https link to a PNG or JPEG, shown instead of the icon.",
          "type": "string",
          "format": "uri",
          "contentMediaType": "image/*",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "size": {
          "title": "Size",
          "description": "Columns x rows the button spans.",
          "default": "1x1",
          "oneOf": [
            {
              "const": "1x1",
              "title": "Normal"
            },
            {
              "const": "2x1",
              "title": "Wide"
            },
            {
              "const": "1x2",
              "title": "Tall"
            },
            {
              "const": "2x2",
              "title": "Large"
            }
          ]
        },
        "fontSize": {
          "title": "Font size",
          "default": "medium",
          "oneOf": [
            {
              "const": "small",
              "title": "Small"
            },
            {
              "const": "medium",
              "title": "Medium"
            },
            {
              "const": "large",
              "title": "Large"
            }
          ]
        },
        "order": {
          "title": "Order",
          "description": "Lower numbers come first.",
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "prominent": {
          "title": "Prominent",
          "description": "Pinned to the top of the grid.",
          "type": "boolean",
          "default": false
        },
        "buttons": {
          "title": "Buttons in this folder",
          "description": "Makes this button a folder that opens these buttons. One level deep. A folder has no action of its own.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderItem"
          }
        }
      },
      "description": "A button runs an action or opens a folder of buttons, never both. A button with neither is ignored by the till.",
      "not": {
        "type": "object",
        "properties": {
          "action": {},
          "buttons": {}
        },
        "required": [
          "action",
          "buttons"
        ]
      }
    },

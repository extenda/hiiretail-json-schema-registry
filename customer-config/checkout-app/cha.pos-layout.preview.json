{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/extenda/hiiretail-json-schema-registry/master/customer-config/checkout-app/cha.pos-layout.preview.json",
  "title": "POS buttons and layout (preview)",
  "description": "Preview kind for the CRG pre-sales demo: describes the function buttons, the payment row and the grid of the Checkout App POS. The app overlays this on the Checkout Engine menu tree; a button only works when its command exists in the engine menu for the store. Temporary kind, to be removed or promoted after the demo.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Use this layout",
      "description": "When off, the POS shows the Checkout Engine menu unchanged.",
      "type": "boolean",
      "default": false
    },
    "mainMenu": {
      "title": "Main menu",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "title": "Sections",
          "description": "The sections in use, up to 8. Each gets a heading and its place in the grid; buttons pick a section by its number.",
          "type": "array",
          "maxItems": 8,
          "x-primary-key": "heading",
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section1"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section2"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section3"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section4"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section5"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section6"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section7"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "slot"
                ],
                "properties": {
                  "slot": {
                    "const": "section8"
                  }
                }
              },
              "minContains": 0,
              "maxContains": 1
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "heading",
              "order"
            ],
            "properties": {
              "slot": {
                "title": "Section",
                "description": "Which of the 8 sections this is. Buttons pick it by this number.",
                "oneOf": [
                  {
                    "const": "section1",
                    "title": "Section 1"
                  },
                  {
                    "const": "section2",
                    "title": "Section 2"
                  },
                  {
                    "const": "section3",
                    "title": "Section 3"
                  },
                  {
                    "const": "section4",
                    "title": "Section 4"
                  },
                  {
                    "const": "section5",
                    "title": "Section 5"
                  },
                  {
                    "const": "section6",
                    "title": "Section 6"
                  },
                  {
                    "const": "section7",
                    "title": "Section 7"
                  },
                  {
                    "const": "section8",
                    "title": "Section 8"
                  }
                ]
              },
              "heading": {
                "title": "Heading",
                "description": "Small heading drawn above the section's buttons.",
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "order": {
                "title": "Order",
                "description": "Position of the section in the grid, starting at 1.",
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              }
            }
          }
        },
        "columns": {
          "title": "Columns",
          "description": "Number of button columns in the function grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 2
        },
        "hideUnlisted": {
          "title": "Hide buttons not listed here",
          "description": "When off, engine buttons that are not configured are shown after the configured ones.",
          "type": "boolean",
          "default": false
        },
        "hideShortcuts": {
          "title": "Hide the fixed shortcut strip",
          "description": "Hides the row of fixed shortcuts under the number pad (PLU, receipt search, business customer, web links, ...). Put the ones you need in the button grid instead.",
          "type": "boolean",
          "default": false
        },
        "buttons": {
          "title": "Always",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Button"
          },
          "x-primary-key": "label",
          "description": "Shown in every state where the checkout allows the action. The state tabs add buttons for one state."
        },
        "states": {
          "title": "Buttons per state",
          "description": "Buttons added to the Always buttons in one state of the till.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "betweenSales": {
              "title": "Between sales",
              "description": "Added to the Always buttons while no sale is open.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Button"
              },
              "x-primary-key": "label"
            },
            "duringSale": {
              "title": "During a sale",
              "description": "Added to the Always buttons while a sale is open.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Button"
              },
              "x-primary-key": "label"
            },
            "lineSelected": {
              "title": "Line selected",
              "description": "Added on top of During a sale while a line on the receipt is selected.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Button"
              },
              "x-primary-key": "label"
            },
            "refund": {
              "title": "Refund mode",
              "description": "With buttons here, refund mode shows the Always buttons plus these. Leave it empty to keep the checkout's own refund menu, including its way out of refund mode.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Button"
              },
              "x-primary-key": "label"
            }
          }
        }
      }
    },
    "paymentRow": {
      "title": "Payment row",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hideUnlisted": {
          "title": "Hide tenders not listed here",
          "description": "When off, the tenders the checkout offers that are not listed here are shown under Other after the listed ones.",
          "type": "boolean",
          "default": false
        },
        "buttons": {
          "title": "Payment buttons",
          "description": "Tenders in the order the till shows them. The first two are the quick buttons on the main screen: the first the small one on the left, the second the large one on the right. The rest open under Other.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PayButton"
          },
          "x-primary-key": "label"
        }
      }
    },
    "numpad": {
      "title": "Number pad",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collapsed": {
          "title": "Number pad folded away at start",
          "description": "Starts the till with the number pad hidden to give the buttons more room. The cashier can still open it with the toggle under the buttons.",
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "Button": {
      "title": "Button",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "title": "Id",
          "description": "Unique within its list, for example return. The store and its workstations match buttons by this id, so keep it when you change a button.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "label": {
          "title": "Label",
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Text on the button. Keep it short: two lines fit."
        },
        "subtitle": {
          "title": "Subtitle",
          "description": "Small text under the label.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "section": {
          "title": "Section",
          "description": "The section the button is shown in. Sections and their headings are set on the General tab. Empty puts the button before the first section.",
          "type": "string",
          "enum": [
            "section1",
            "section2",
            "section3",
            "section4",
            "section5",
            "section6",
            "section7",
            "section8"
          ]
        },
        "action": {
          "title": "Action",
          "description": "Pick a category, then the action from that category's list. Leave the category unset to make a folder.",
          "oneOf": [
            {
              "title": "Sale",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "saleAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "sale"
                },
                "saleAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "suspendOrder",
                      "title": "Suspend order (during a sale)"
                    },
                    {
                      "const": "retrieveOrder",
                      "title": "Retrieve suspended order (between sales)"
                    },
                    {
                      "const": "cancelOrder",
                      "title": "Cancel order (during a sale)"
                    },
                    {
                      "const": "voidLine",
                      "title": "Void selected line (line selected)"
                    },
                    {
                      "const": "quantity",
                      "title": "Change quantity (line selected)"
                    },
                    {
                      "const": "repeatLastItem",
                      "title": "Repeat last item (during a sale)"
                    },
                    {
                      "const": "manualDepartment",
                      "title": "Manual department sale"
                    },
                    {
                      "const": "tare",
                      "title": "Tare (line selected)"
                    },
                    {
                      "const": "rfidRead",
                      "title": "Read RFID"
                    }
                  ]
                }
              }
            },
            {
              "title": "Returns and receipts",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "receiptAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "receipt"
                },
                "receiptAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "returnFromReceipt",
                      "title": "Return from a receipt"
                    },
                    {
                      "const": "findReceipt",
                      "title": "Find a receipt"
                    },
                    {
                      "const": "receiptComment",
                      "title": "Receipt comment (during a sale)"
                    },
                    {
                      "const": "lineComment",
                      "title": "Comment on line (line selected)"
                    },
                    {
                      "const": "returnWithoutReceipt",
                      "title": "Return without receipt"
                    },
                    {
                      "const": "complaint",
                      "title": "Complaint"
                    },
                    {
                      "const": "exchange",
                      "title": "Exchange"
                    }
                  ]
                }
              }
            },
            {
              "title": "Discounts and prices",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "priceAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "price"
                },
                "priceAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "discountLineAmount",
                      "title": "Discount on line, amount (line selected)"
                    },
                    {
                      "const": "discountLinePercent",
                      "title": "Discount on line, percent (line selected)"
                    },
                    {
                      "const": "discountOrder",
                      "title": "Discount on whole order (during a sale)"
                    },
                    {
                      "const": "removeLineDiscount",
                      "title": "Remove discount from line (line selected)"
                    },
                    {
                      "const": "changePrice",
                      "title": "Change price of line (line selected)"
                    },
                    {
                      "const": "priceCheck",
                      "title": "Check a price"
                    }
                  ]
                }
              }
            },
            {
              "title": "Customer",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "customerAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "customer"
                },
                "customerAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "b2bCustomer",
                      "title": "Business customer"
                    },
                    {
                      "const": "customerOrderSearch",
                      "title": "Find a customer order"
                    },
                    {
                      "const": "customer",
                      "title": "Customer (during a sale)"
                    },
                    {
                      "const": "loyaltyVoucher",
                      "title": "Loyalty voucher (during a sale)"
                    },
                    {
                      "const": "externalCustomer",
                      "title": "Register external customer (during a sale)"
                    },
                    {
                      "const": "customerCardNumber",
                      "title": "Register customer card (during a sale)"
                    },
                    {
                      "const": "retrieveCustomerOrder",
                      "title": "Retrieve customer order"
                    }
                  ]
                }
              }
            },
            {
              "title": "Cash drawer",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "cashAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "cash"
                },
                "cashAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "openCashDrawer",
                      "title": "Open cash drawer"
                    },
                    {
                      "const": "paidIn",
                      "title": "Paid in"
                    },
                    {
                      "const": "paidOut",
                      "title": "Paid out"
                    }
                  ]
                }
              }
            },
            {
              "title": "Gift cards",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "giftCardAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "giftCard"
                },
                "giftCardAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "giftCardBalance",
                      "title": "Gift card balance"
                    },
                    {
                      "const": "issueGiftCard",
                      "title": "Issue gift card"
                    },
                    {
                      "const": "reloadGiftCard",
                      "title": "Reload gift card"
                    }
                  ]
                }
              }
            },
            {
              "title": "Lookups and screens",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "screenAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "screen"
                },
                "screenAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "findItem",
                      "title": "Find an item"
                    },
                    {
                      "const": "pluMenu",
                      "title": "PLU menu"
                    },
                    {
                      "const": "variantSearch",
                      "title": "Browse categories"
                    },
                    {
                      "const": "externalLinks",
                      "title": "Web links"
                    },
                    {
                      "const": "activePromotions",
                      "title": "Active promotions"
                    }
                  ]
                }
              }
            },
            {
              "title": "Custom commands",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "command"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "command"
                },
                "command": {
                  "title": "Custom command",
                  "description": "The exact Checkout Engine command name, for example SuspendOrderCommand. Ask Extenda before using it.",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.]{1,80}$"
                }
              }
            }
          ]
        },
        "icon": {
          "$ref": "#/$defs/Icon",
          "description": "Leave empty to use the icon of the action. Pick one only to replace it."
        },
        "imageUrl": {
          "title": "Picture",
          "description": "Optional. Https link to a PNG or JPEG, shown instead of the icon.",
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "contentMediaType": "image/*",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "size": {
          "title": "Size",
          "description": "Wide takes two columns, tall two rows, large both.",
          "default": "1x1",
          "oneOf": [
            {
              "const": "1x1",
              "title": "Normal"
            },
            {
              "const": "2x1",
              "title": "Wide"
            },
            {
              "const": "1x2",
              "title": "Tall"
            },
            {
              "const": "2x2",
              "title": "Large"
            }
          ]
        },
        "fontSize": {
          "title": "Font size",
          "default": "medium",
          "oneOf": [
            {
              "const": "small",
              "title": "Small"
            },
            {
              "const": "medium",
              "title": "Medium"
            },
            {
              "const": "large",
              "title": "Large"
            }
          ],
          "description": "Size of the label text."
        },
        "order": {
          "title": "Order",
          "description": "Position inside the button's section, starting at 1. Lower numbers come first.",
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "prominent": {
          "title": "Prominent",
          "description": "Pinned to the top of the grid.",
          "type": "boolean",
          "default": false
        },
        "buttons": {
          "title": "Buttons in this folder",
          "description": "Buttons that open from this folder. Leave Select type empty on the folder itself.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderItem"
          },
          "x-primary-key": "label"
        }
      },
      "description": "A button runs an action or opens a folder of buttons, never both. A button with neither is ignored by the till.",
      "not": {
        "type": "object",
        "properties": {
          "action": {},
          "buttons": {}
        },
        "required": [
          "action",
          "buttons"
        ]
      }
    },
    "FolderItem": {
      "title": "Button in a folder",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "title": "Id",
          "description": "Unique within its list, for example return. The store and its workstations match buttons by this id, so keep it when you change a button.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "label": {
          "title": "Label",
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Text on the button. Keep it short: two lines fit."
        },
        "subtitle": {
          "title": "Subtitle",
          "description": "Small text under the label.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60
        },
        "action": {
          "title": "Action",
          "description": "Pick a category, then the action from that category's list. Leave the category unset to make a folder.",
          "oneOf": [
            {
              "title": "Sale",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "saleAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "sale"
                },
                "saleAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "suspendOrder",
                      "title": "Suspend order (during a sale)"
                    },
                    {
                      "const": "retrieveOrder",
                      "title": "Retrieve suspended order (between sales)"
                    },
                    {
                      "const": "cancelOrder",
                      "title": "Cancel order (during a sale)"
                    },
                    {
                      "const": "voidLine",
                      "title": "Void selected line (line selected)"
                    },
                    {
                      "const": "quantity",
                      "title": "Change quantity (line selected)"
                    },
                    {
                      "const": "repeatLastItem",
                      "title": "Repeat last item (during a sale)"
                    },
                    {
                      "const": "manualDepartment",
                      "title": "Manual department sale"
                    },
                    {
                      "const": "tare",
                      "title": "Tare (line selected)"
                    },
                    {
                      "const": "rfidRead",
                      "title": "Read RFID"
                    }
                  ]
                }
              }
            },
            {
              "title": "Returns and receipts",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "receiptAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "receipt"
                },
                "receiptAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "returnFromReceipt",
                      "title": "Return from a receipt"
                    },
                    {
                      "const": "findReceipt",
                      "title": "Find a receipt"
                    },
                    {
                      "const": "receiptComment",
                      "title": "Receipt comment (during a sale)"
                    },
                    {
                      "const": "lineComment",
                      "title": "Comment on line (line selected)"
                    },
                    {
                      "const": "returnWithoutReceipt",
                      "title": "Return without receipt"
                    },
                    {
                      "const": "complaint",
                      "title": "Complaint"
                    },
                    {
                      "const": "exchange",
                      "title": "Exchange"
                    }
                  ]
                }
              }
            },
            {
              "title": "Discounts and prices",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "priceAction"
              ],
              "properties": {
                "category": {
                  "title": "Category",
                  "const": "price"
                },
                "priceAction": {
                  "title": "Action",
                  "description": "The note in brackets says when the till shows the button; without a note it shows at all times.",
                  "oneOf": [
                    {
                      "const": "discountLineAmount",
                      "title": "Discount on line, amount (line selected)"
                    },
                    {
                      "const": "discountLinePercent",
                      "title": "Discount on line, percent (line selected)"
                    },
                    {
                      "const": "discountOrder",
                      "title": "Discount on whole order (during a sale)"
                    },
                    {
                      "const": "removeLineDiscount",
                      "title": "Remove discount from line (line selected)"
                    },
                    {
                      "const": "changePrice",
                      "title": "Change price of line (line selected)"

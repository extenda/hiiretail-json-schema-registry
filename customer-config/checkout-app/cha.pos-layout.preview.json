    "PayButton": {
      "title": "Payment button",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "title": "Id",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "description": "Unique within the layout, for example return."
        },
        "tender": {
          "title": "Tender",
          "description": "The way of paying this button stands for. Pick from the list. The till shows the button only when the store's checkout offers that tender.",
          "oneOf": [
            {
              "const": "cash",
              "title": "Cash"
            },
            {
              "const": "card",
              "title": "Card"
            },
            {

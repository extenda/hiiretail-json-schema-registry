{
  "$id": "svi.omnium-oms-connector-config.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnium OMS Connector Configuration",
  "description": "Configuration used by an OMS connector to translate source-system statuses, shipment methods, tenders, rewards, and transactions into target customer order values.",
  "$comment": "Every mapping is a list of rows {id, value}; id = the OMS (source) value, target = HiiRetail. Field names are the same in every mapping, so one converter handles all of them. Every mapping is optional and defaults to []. Values are matched exactly and case-sensitively; each id can be mapped once. The field is named id because CCC matches list items by id when a patch is applied; without it, patched rows are added again as duplicates. All mappings are two-way: OMS to HiiRetail uses every row; HiiRetail to OMS uses the first row (in list order) with that target value. Row order is therefore meaningful and must be preserved. Target values follow the HiiRetail Customer Order External API v1.0. uniqueItemProperties requires ajv-keywords; errorMessage requires ajv-errors. x-primary-key names each row in the configuration portal's ListWithDetail layout. On-screen labels and help texts are set per connector in the UI schema; this schema's titles are generic fallbacks.",
  "type": "object",
  "properties": {
    "OrderStatusMapping": {
      "type": "array",
      "title": "Order statuses",
      "default": [],
      "maxItems": 500,
      "uniqueItemProperties": [
        "id"
      ],
      "errorMessage": {
        "uniqueItemProperties": "This value is already mapped. Each value can be mapped only once.",
        "maxItems": "This list can have at most 500 rows."
      },
      "items": {
        "type": "object",
        "title": "Order status",
        "required": [
          "id",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "title": "OMS status",
            "description": "Type it exactly as it is sent, including upper and lower case, with no spaces at the start or end.",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^\\S(.*\\S)?$",
            "examples": [
              "New"
            ],
            "errorMessage": {
              "minLength": "This value is required.",
              "maxLength": "Keep it to 100 characters or fewer.",
              "pattern": "Remove the space at the start or end."
            }
          },
          "value": {
            "type": "string",
            "title": "HiiRetail status",
            "description": "Select the matching value.",
            "enum": [
              "CREATED",
              "IN_PROGRESS",
              "CANCELLED",
              "FULFILLED"
            ],
            "examples": [
              "CREATED"
            ],
            "errorMessage": {
              "enum": "Select a value from the list."
            }
          }
        },
        "additionalProperties": false,
        "errorMessage": {
          "required": {
            "id": "This value is required.",
            "value": "This value is required."
          },
          "additionalProperties": "A row can only contain the two mapped values."
        }
      },
      "examples": [
        [
          {
            "id": "New",
            "value": "CREATED"
          },
          {
            "id": "InProgress",
            "value": "IN_PROGRESS"
          },
          {
            "id": "Processing",
            "value": "IN_PROGRESS"
          },
          {
            "id": "AwaitingInventory",
            "value": "IN_PROGRESS"
          },
          {
            "id": "Completed",
            "value": "FULFILLED"
          },
          {
            "id": "Shipped",
            "value": "FULFILLED"
          },
          {
            "id": "Delivered",
            "value": "FULFILLED"
          },
          {
            "id": "OrderCanceled",
            "value": "CANCELLED"
          }
        ]
      ],
      "x-primary-key": "id"
    },

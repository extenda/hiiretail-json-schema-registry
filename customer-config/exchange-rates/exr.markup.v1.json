{
  "$id": "exr.markup.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExchangeRatesMarkups",
  "description": "List of exchange rates markups",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Markup"
  },
  "$defs": {
    "Markup": {
      "title": "Markup",
      "description": "The markup for a given exchange rate",
      "type": "object",
      "required": [
        "id",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id to identify exchange rate, i.e. concatenated values of type, currencyIdFrom and currencyIdTo. For instance SALES-EUR-NOK."
        },
        "config": {
          "type": "object",
          "$ref": "#/$defs/Markup/$defs/Config"
        }
      },
      "$defs": {
        "Config": {
          "title": "Config",
          "description": "Set of available settings for exchange rate markup",
          "type": "object",
          "required": [
            "type",
            "currencyIdFrom",
            "currencyIdTo",
            "markup"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "SALES",
                "PURCHASE",
                "INTERCOMPANY"
              ],
              "description": "Indicates type of exchange rate"
            },
            "currencyIdFrom": {
              "type": "string",
              "description": "Currency the rate is expressed in — the currency being converted TO. ISO4217."
            },
            "currencyIdTo": {
              "type": "string",
              "description": "Currency being priced — the currency being converted FROM. ISO4217."
            },
            "markup": {
              "type": "number",
              "description": "Value for markup"
            }
          }
        }
      }
    }
  }
}
